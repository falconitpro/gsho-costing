# /etc/gsho/dr.env — ТОЛЬКО на резервной ВМ (root, 0600). Реальные значения — вне репозитория и чата (D-024).
DR_STANDBY_DOMAIN=crm2.dobrov.pro
# Флаг «работаем на резерве»: бакет с публичным чтением объекта failover.json (только этот объект, без секретов)
DR_FLAG_BUCKET_URL=https://storage.yandexcloud.net/<БАКЕТ_ФЛАГА>
# Статический ключ SA флага (storage.uploader только на бакет флага)
DR_FLAG_ACCESS_KEY_ID=<ИЗ_ХРАНИЛИЩА_ВЛАДЕЛЬЦА>
DR_FLAG_SECRET_ACCESS_KEY=<ИЗ_ХРАНИЛИЩА_ВЛАДЕЛЬЦА>
# Необязательно: команда обновления A-записи crm2 (получает IP в $DR_IP). Пусто — запись обновляется вручную у R01.
# DR_DNS_UPDATE_CMD=

# /etc/gsho/restore.env (там же): RESTIC_REPOSITORY рабочих копий, RESTIC_PASSWORD, ключ sa-crm-prod-restore (только чтение),
#   AWS_DEFAULT_REGION=ru-central1
# /etc/gsho/backup-failover.env (там же): как backup.env, но отдельный бакет/SA для копий РЕЗЕРВА и BACKUP_HOST_TAG=gsho-failover
# На РАБОЧЕМ сервере:
#   /etc/gsho/dr-guard.env: DR_FLAG_URL=https://storage.yandexcloud.net/<БАКЕТ_ФЛАГА>/failover.json
#   /etc/gsho/restore-failover.env: чтение копий резерва (для возврата, failback.sh --stage=primary)
