[Unit]
Description=GSHO DR: переадресация crm → crm2, пока идёт работа на резервном сервере (D-084)
Documentation=file:///usr/local/lib/gsho-dr/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/gsho/dr-guard.env
ExecStart=/bin/bash /usr/local/lib/gsho-dr/flag-guard.sh
TimeoutStartSec=60
