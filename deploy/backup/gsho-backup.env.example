# Пример /etc/gsho/backup.env — ТОЛЬКО имена и заглушки. Реальный файл: владелец root, режим 0600, вне репозитория.
# Значения секретов берутся из защищённого хранилища владельца; в git, CRM, тикеты и чаты не попадают.

# Репозиторий restic в приватном бакете Yandex Object Storage
RESTIC_REPOSITORY=s3:https://storage.yandexcloud.net/<ИМЯ_БАКЕТА>/gsho-prod
# Длинный случайный пароль шифрования restic (без него копии не расшифровать)
RESTIC_PASSWORD=<ИЗ_ХРАНИЛИЩА_ВЛАДЕЛЬЦА>
# Статический ключ сервисного аккаунта sa-gsho-backup (storage.editor только на этот бакет)
AWS_ACCESS_KEY_ID=<ИЗ_ХРАНИЛИЩА_ВЛАДЕЛЬЦА>
AWS_SECRET_ACCESS_KEY=<ИЗ_ХРАНИЛИЩА_ВЛАДЕЛЬЦА>
AWS_DEFAULT_REGION=ru-central1

# Каталоги на хосте (не секреты)
BACKUP_STATUS_DIR=/var/lib/gsho-backup/status
BACKUP_STAGING_DIR=/var/lib/gsho-backup/staging
BACKUP_COMPOSE_DIR=/opt/gsho-costing
BACKUP_TIMEZONE=Europe/Moscow
# Файлы compose стенда: нужны, чтобы `docker compose exec` нашёл проект
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Необязательные (значения по умолчанию)
# BACKUP_MIN_FREE_MB=1024          # меньше — копия не начинается (disk_full)
# BACKUP_KEEP_DAILY=90
# BACKUP_KEEP_MONTHLY=12
# BACKUP_DEEP_CHECK_WEEKDAY=7      # воскресенье: restic check --read-data-subset=5%
# BACKUP_HOST_TAG=gsho-prod
