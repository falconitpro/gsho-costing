{
	# браузеры не передают SNI при входе по IP — отдаём сертификат запасного адреса
	default_sni {$FALLBACK_HOST:localhost}
}

(app) {
	encode gzip
	@protected not path /api/health
	basic_auth @protected {
		{$BASIC_AUTH_USER:berghaus} {$BASIC_AUTH_HASH}
	}
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}

# Основной адрес: сертификат Let's Encrypt выпускается автоматически, когда DNS указывает на сервер
{$DOMAIN} {
	# если сертификат выдан Yandex Certificate Manager (deploy/fetch-cert.sh) — здесь появится директива tls
	import /etc/caddy/site-tls/*.caddy
	import app
}

# Запасной вход по IP (самоподписанный сертификат Caddy, браузер покажет предупреждение) — пока нет сертификата для домена
https://{$FALLBACK_HOST:localhost} {
	tls internal
	import app
}
