{
	# браузеры не передают SNI при входе по IP — отдаём сертификат запасного адреса
	default_sni {$FALLBACK_HOST:localhost}
}

(app) {
	encode gzip
	# заголовки безопасности: HSTS, запрет встраивания во фреймы, политика источников для приложения
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	# лимит тела запроса: видео с приёмки до 300 МБ, остальное ограничивает API
	request_body {
		max_size 310MB
	}
	# общий пароль стенда (basic_auth) снят 08.11.2026 по решению владельца: доступ закрывает страница входа приложения
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}

# Основной адрес: сертификат Let's Encrypt выпускается автоматически, когда DNS указывает на сервер
{$DOMAIN} {
	# если сертификат выдан Yandex Certificate Manager (deploy/fetch-cert.sh) — здесь появится директива tls
	import /etc/caddy/site-tls/*.caddy
	import app
}

# Запасной вход по IP (самоподписанный сертификат Caddy, браузер покажет предупреждение) — пока нет сертификата для домена
https://{$FALLBACK_HOST:localhost} {
	tls internal
	import app
}
