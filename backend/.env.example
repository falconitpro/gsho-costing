APP_ENV=dev                       # dev | prod
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://gsho:gsho@db:5432/gsho
SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:5173

# Вход: dev | entra | yandex | keycloak
AUTH_PROVIDER=dev
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
OIDC_GROUP_ROLE_MAP=             # <entra-group-id>:manager,<group-id>:cd,...
GRAPH_TENANT_ID=

# Хранилище: local | sharepoint | yandex_disk | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=
S3_ENDPOINT=
S3_BUCKET=gsho
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Почта: console | outlook | yandex_smtp ; мессенджер: console | wecom
MAIL_PROVIDER=console
MAIL_SHARED_MAILBOX=sales@example.com
MESSENGER_PROVIDER=console
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# Переводчик RU<->CN (задача 4): yandex | console. Ключ API Яндекс Переводчика и каталог Yandex Cloud
TRANSLATOR_PROVIDER=yandex
YANDEX_TRANSLATE_API_KEY=
YANDEX_FOLDER_ID=

# Реквизиты клиента по ИНН (ЕГРЮЛ/ЕГРИП): dadata — DaData «Организация по ИНН» (ключ в личном кабинете dadata.ru), none — вручную
COMPANY_REGISTRY_PROVIDER=dadata
DADATA_API_KEY=

# МойСклад — перенос фото запчастей (JSON API 1.2). Токен создаёт владелец в МойСклад: Настройки → Токены; в чат не передаётся.
MOYSKLAD_TOKEN=

# Безопасность входа (docs/operations/04, D-033…D-036)
SESSION_ABSOLUTE_HOURS=12          # вход не дольше 12 ч; «Запомнить меня» только подставляет логин (D-041)
MFA_POLICY=optional                # optional | required (required — только после того, как все включили код)
MFA_ENCRYPTION_KEY=                # результат «openssl rand -base64 32» (44 символа); в рабочем режиме обязателен, задать ДО включения кодов
# Задать на сервере без ручного копирования (ключ покажется один раз — сохранить в защищённую заметку):
#   KEY=$(openssl rand -base64 32); sudo sed -i '/^MFA_ENCRYPTION_KEY=/d' backend/.env; echo "MFA_ENCRYPTION_KEY=$KEY" | sudo tee -a backend/.env >/dev/null; echo "$KEY"; unset KEY
LEGACY_SESSIONS_UNTIL=             # ISO-время окна, когда принимаются старые cookie без sid; пусто — не принимаются

# Проверка загрузок антивирусом (deploy/clamav/install.md, D-049): off | clamav. При APP_ENV=prod — только clamav.
FILE_SCAN=off
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_TIMEOUT=120
QUARANTINE_DIR=./data/quarantine      # вне STORAGE_LOCAL_ROOT: сюда scripts.scan_storage переносит найденные заражённые файлы
# Класс данных (D-050): пусто — по APP_ENV (prod → production, recovery → recovery, иначе synthetic)
DATA_CLASSIFICATION=
